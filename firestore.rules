rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net: Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    // Global helper functions
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    // User Profile Entity Validation Helper
    function isValidUserProfile(data) {
      return data.userId is string && data.userId.size() <= 128 && data.userId.matches('^[a-zA-Z0-9_\\-]+$')
        && data.displayName is string && data.displayName.size() > 0 && data.displayName.size() <= 64
        && (!('email' in data) || (data.email is string && data.email.size() <= 128))
        && data.highScore is number && data.highScore >= 0
        && data.highestWave is number && data.highestWave >= 0
        && data.totalKills is number && data.totalKills >= 0
        && (!('totalHeadshots' in data) || (data.totalHeadshots is number && data.totalHeadshots >= 0))
        && (!('totalGamesPlayed' in data) || (data.totalGamesPlayed is number && data.totalGamesPlayed >= 0))
        && (!('unlockedAudioLogsCount' in data) || (data.unlockedAudioLogsCount is number && data.unlockedAudioLogsCount >= 0))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // Leaderboard Entry Validation Helper
    function isValidLeaderboardEntry(data) {
      return data.userId is string && data.userId.size() <= 128 && data.userId.matches('^[a-zA-Z0-9_\\-]+$')
        && data.displayName is string && data.displayName.size() > 0 && data.displayName.size() <= 64
        && data.score is number && data.score >= 0
        && data.wave is number && data.wave >= 1
        && data.kills is number && data.kills >= 0
        && data.headshots is number && data.headshots >= 0
        && data.victory is bool
        && data.createdAt is timestamp;
    }

    // User Profiles Collection
    match /users/{userId} {
      allow get: if isSignedIn() && request.auth.uid == userId && isValidId(userId);
      allow list: if false;

      allow create: if isSignedIn()
        && request.auth.uid == userId
        && isValidId(userId)
        && isValidUserProfile(incoming())
        && incoming().userId == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isSignedIn()
        && request.auth.uid == userId
        && isValidId(userId)
        && isValidUserProfile(incoming())
        && incoming().userId == existing().userId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'displayName', 'email', 'highScore', 'highestWave', 'totalKills',
          'totalHeadshots', 'totalGamesPlayed', 'unlockedAudioLogsCount', 'updatedAt'
        ]);

      allow delete: if false;
    }

    // Global Leaderboard Collection
    match /leaderboard/{runId} {
      allow get: if isValidId(runId);
      allow list: if true;

      allow create: if isSignedIn()
        && isValidId(runId)
        && isValidLeaderboardEntry(incoming())
        && incoming().userId == request.auth.uid
        && incoming().createdAt == request.time;

      allow update, delete: if false;
    }
  }
}
