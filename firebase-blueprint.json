{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile with persistent survivor statistics and cloud progression.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "Unique authentication UID of the survivor",
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "maxLength": 128
        },
        "displayName": {
          "type": "string",
          "description": "Public survivor callsign or username",
          "maxLength": 64
        },
        "email": {
          "type": "string",
          "description": "Authenticated email address of the survivor",
          "maxLength": 128
        },
        "highScore": {
          "type": "number",
          "description": "Highest score achieved across all runs"
        },
        "highestWave": {
          "type": "number",
          "description": "Highest wave survived across all runs"
        },
        "totalKills": {
          "type": "number",
          "description": "Cumulative zombies eliminated"
        },
        "totalHeadshots": {
          "type": "number",
          "description": "Cumulative headshot eliminations"
        },
        "totalGamesPlayed": {
          "type": "number",
          "description": "Total survival attempts completed"
        },
        "unlockedAudioLogsCount": {
          "type": "number",
          "description": "Total quarantine audio logs discovered"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Last update server timestamp"
        }
      },
      "required": ["userId", "displayName", "highScore", "highestWave", "totalKills", "createdAt", "updatedAt"]
    },
    "LeaderboardEntry": {
      "title": "LeaderboardEntry",
      "description": "Global quarantine zone leaderboard record for a completed survival run.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "UID of the player submitting the score",
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "maxLength": 128
        },
        "displayName": {
          "type": "string",
          "description": "Player callsign displayed on the leaderboard",
          "maxLength": 64
        },
        "score": {
          "type": "number",
          "description": "Final score earned in this run"
        },
        "wave": {
          "type": "number",
          "description": "Highest wave reached in this run"
        },
        "kills": {
          "type": "number",
          "description": "Total zombies eliminated in this run"
        },
        "headshots": {
          "type": "number",
          "description": "Total headshot eliminations in this run"
        },
        "victory": {
          "type": "boolean",
          "description": "Whether the player successfully evacuated or fell in combat"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp"
        }
      },
      "required": ["userId", "displayName", "score", "wave", "kills", "headshots", "victory", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "User profile with survivor career statistics."
    },
    "/leaderboard/{runId}": {
      "schema": "LeaderboardEntry",
      "description": "Global community leaderboard records."
    }
  }
}
